{
  "name": "aroundate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev apps/web --hostname 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "eslint apps packages tests scripts vitest.config.ts playwright.config.ts",
    "format": "prettier --write apps packages tests scripts db infra *.json *.ts *.mjs .github",
    "format:check": "prettier --check apps packages tests scripts db infra *.json *.ts *.mjs .github",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "build": "node scripts/build.mjs",
    "start:api": "node dist/api/apps/api/src/main.js",
    "start:web": "node scripts/start-web.mjs",
    "openapi:check": "node scripts/openapi-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run openapi:check",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "setup:local": "node scripts/setup-local.mjs",
    "db:prepare-ci": "tsx scripts/prepare-ci-database.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
