# Local sandbox; no provider keys required. Never use demo identities in production.
NODE_ENV=development
APP_MODE=sandbox
WEB_ORIGIN=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
DATABASE_URL=postgresql://aroundate_app:REPLACE_LOCAL_APP_PASSWORD@localhost:5432/aroundate
MIGRATION_DATABASE_URL=postgresql://aroundate_migrator:REPLACE_LOCAL_MIGRATION_PASSWORD@localhost:5432/aroundate
REDIS_URL=redis://localhost:6379
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=aroundate-web
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=aroundate-api
OIDC_ALGORITHM=RS256
# All live providers/analytics are disabled until approved credentials/terms are configured.
GOOGLE_ENABLED=false
INSTAGRAM_ENABLED=false
TIKTOK_ENABLED=false
ANALYTICS_ENABLED=false
PAID_FEATURES_ENABLED=false
CONTROLLER_LEGAL_NAME=
CONTROLLER_EMAIL=
SECURITY_CONTACT=
